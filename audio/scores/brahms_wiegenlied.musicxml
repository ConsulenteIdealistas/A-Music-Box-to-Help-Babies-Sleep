  <work>
    <work-title>Wiegenlied (Brahms' Lullaby), Op. 49 No. 4</work-title>
  </work>
  <identification>
    <creator type="composer">Johannes Brahms</creator>
    <rights>Melody: public domain. Transcription: see audio/SONGS.md</rights>
    <miscellaneous>
      <miscellaneous-field name="source">LilyPond score in Wikipedia 'Wiegenlied (Brahms)' (Eb major); transposed to C major, +8va</miscellaneous-field>
      <miscellaneous-field name="transcription">Notes read from the LilyPond source text and entered as note data in audio/make_musicxml.py; transposition (Eb to C major, +8va) applied in the data. No notation software used. No machine cross-check recorded; the .ly source file was not retained in the project work folder.</miscellaneous-field>
      <miscellaneous-field name="tools">Transcription record and MusicXML generation: Python (audio/make_musicxml.py). Music-box render: SuperCollider (Klank) via audio/render_klank.py. Cross-checks and measurement: SoX; loudness: ffmpeg. Full record: audio/PROVENANCE.md</miscellaneous-field>
    </miscellaneous>
  </identification>
  <part-list>
